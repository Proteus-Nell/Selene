          "sql": "CREATE TABLE IF NOT EXISTS \"symptoms\" (\"epoch_day\" INTEGER NOT NULL REFERENCES day_logs (epoch_day) ON DELETE CASCADE, \"symptom\" TEXT NOT NULL, \"severity\" TEXT NOT NULL, PRIMARY KEY (\"epoch_day\", \"symptom\"));"
