<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive launcher icon (AND-34). API 26 and up.

     Two layers, each 108 units, of which the launcher shows the middle 72 and
     masks it to whatever shape the device uses. The mipmap-*dpi PNGs beside
     this file are the same design flattened for older launchers, which have no
     adaptive icon and would otherwise fall back to nothing.

     The background is a colour resource rather than a drawable so that
     values-night can restate it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
