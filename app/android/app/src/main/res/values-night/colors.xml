<?xml version="1.0" encoding="utf-8"?>
<!-- The dark halves of values/colors.xml (AND-34).

     A launcher that follows the system theme picks the icon colours up from
     here; one that does not keeps the light set, which is a complete and
     correct icon either way. Nothing depends on the launcher honouring it. -->
<resources>
    <!-- AppColors.darkSurfaceContainer. -->
    <color name="ic_launcher_background">#20221C</color>
    <!-- AppColors.darkOnSurface. Inverting the mark is deliberate: the
         artwork is a silhouette, so in dark mode the canopy reads light and
         the sky behind it dark. It is the same drawing as a negative, and it
         is the only way it stays visible on a near-black tile. -->
    <color name="ic_launcher_ink">#E5E7E0</color>

    <!-- AppColors.darkSurface. -->
    <color name="splash_background">#161713</color>
</resources>
