<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon's foreground layer (AND-38).

     A tinted bitmap rather than a vector, because the artwork is a raster
     silhouette: app/android/logo-source.png, placed on the 108-unit adaptive
     canvas by tools/scripts/gen_launcher_icon.py.

     The tint is what makes one bitmap serve both themes. The source art is
     uniformly near-black, so its alpha channel is the only part carrying any
     information; emitting it white-on-transparent and colouring it from a
     resource means values-night can restate the colour. Baking the ink in
     would need two sets of PNGs, and would leave a black mark on a near-black
     tile in dark mode, where it would simply not be visible. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@mipmap/ic_launcher_logo"
    android:tint="@color/ic_launcher_ink" />
