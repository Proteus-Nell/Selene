<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8.0 to 11 (API 26-30), the range below dataExtractionRules.
  Belt and braces alongside android:allowBackup="false".
  See docs/PLAN.md 6.5.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
