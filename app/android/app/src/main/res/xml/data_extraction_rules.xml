<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+). Excludes everything from BOTH cloud backup and
  device-to-device transfer.

  This is not redundant with android:allowBackup="false". On Android 12+,
  device-to-device transfer is governed separately from cloud backup, so
  allowBackup alone does not stop cycle data moving to a new phone.
  See docs/PLAN.md 6.5.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
