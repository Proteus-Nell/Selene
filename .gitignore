# ============================================================================
# Period-Tracker
# Monorepo: research/ (Python)  +  app/ (Flutter)
#
# WARNING: the stock Python .gitignore template ignores `lib/`, `build/`, and
# `dist/`. In a Flutter repo that silently excludes ALL Dart source, because
# Flutter's main source directory is app/lib/. Every Python pattern below is
# therefore SCOPED to research/ and no bare `lib/` rule exists anywhere.
#
# Verify after any edit (all three must print NOTHING):
#   git check-ignore -v app/lib/main.dart
#   git check-ignore -v app/lib/domain/predict/bayes_filter.dart
#   git check-ignore -v research/uv.lock
# ============================================================================


# ---------------------------------------------------------------------------
# Python  (scoped to research/ so it can never touch app/lib)
# ---------------------------------------------------------------------------
research/**/__pycache__/
research/**/*.py[cod]
research/**/*$py.class
research/**/*.so
research/.Python
research/build/
research/develop-eggs/
research/dist/
research/downloads/
research/eggs/
research/.eggs/
research/lib/
research/lib64/
research/parts/
research/sdist/
research/var/
research/wheels/
research/share/python-wheels/
research/*.egg-info/
research/.installed.cfg
research/*.egg
research/MANIFEST

# Virtual environments
research/.venv/
research/venv/
research/ENV/
.venv/
venv/

# Test, coverage, and type caches
research/.pytest_cache/
research/.mypy_cache/
research/.ruff_cache/
research/.hypothesis/
research/.tox/
research/.nox/
research/.coverage
research/.coverage.*
research/coverage.xml
research/htmlcov/

# Notebooks (outputs are stripped by nbstripout; checkpoints are never wanted)
research/.ipynb_checkpoints/
research/**/*.nbconvert.ipynb

# NOTE: uv.lock and requirements.txt ARE committed. Do not add them here.


# ---------------------------------------------------------------------------
# Flutter / Dart
# NOTE: app/lib/ is SOURCE and must be committed. Never add a bare `lib/`.
# ---------------------------------------------------------------------------
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/.pub-cache/
app/.pub/
app/build/
app/coverage/
app/doc/api/
app/*.lcov
.flutter-versions

# FVM pins the SDK version. .fvmrc IS committed; the resolved SDK symlink is not.
app/.fvm/
.fvm/

# Generated code. CI runs `build_runner build` before analyze/test, so these are
# reproducible and are ignored to keep diffs readable.
# If you ever want fresh clones to analyze without a codegen step, delete these
# three lines and commit the generated files instead.
app/**/*.g.dart
app/**/*.freezed.dart
app/**/generated_plugin_registrant.dart

# Golden test failure output (the accepted goldens themselves ARE committed)
app/test/**/failures/


# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
app/android/.gradle/
app/android/.kotlin/
app/android/captures/
app/android/local.properties
app/android/.idea/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
app/android/**/GeneratedPluginRegistrant.java

# SIGNING SECRETS. Committing any of these compromises the release key and
# means you can never safely upgrade an installed app again.
app/android/key.properties
*.jks
*.keystore
*.p12


# ---------------------------------------------------------------------------
# iOS / macOS  (deferred build target, ignores staged in advance)
# ---------------------------------------------------------------------------
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/ephemeral/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh
app/ios/Flutter/app.flx
app/ios/Flutter/app.zip
app/ios/Flutter/flutter_assets/
app/ios/ServiceDefinitions.json
app/ios/Runner/GeneratedPluginRegistrant.*
**/xcuserdata/
**/*.pbxuser
**/*.mode1v3
**/*.mode2v3
**/*.perspectivev3
**/*.moved-aside
*.ipa
*.dSYM.zip


# ---------------------------------------------------------------------------
# Project data and experiment artifacts
# ---------------------------------------------------------------------------
# Datasets are NEVER committed: licensing and participant consent live upstream.
# data/DATASETS.md IS committed. It records source, license, checksum, and
# row count for every dataset, and is how "dataset versioning" works here.
data/*
!data/DATASETS.md

# MLflow local tracking store (file:./mlruns). Runs are reproducible from
# params + seed + dataset checksum, so the store itself is disposable.
mlruns/
research/mlruns/

# The Python -> Dart contract artifacts under artifacts/ ARE committed:
# priors_*.json, golden/predictor_cases_*.json, models/*.pte
# Do not add artifacts/ here.


# ---------------------------------------------------------------------------
# Secrets and local config
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
secrets/


# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.idea/
*.iml
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/tasks.json
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
